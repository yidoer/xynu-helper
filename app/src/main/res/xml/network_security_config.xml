<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      默认策略：禁止明文。

      原文件没有 <base-config>，等于继承平台默认值 —— 而这个 app 的
      targetSdk 是 35，平台默认本来就是 cleartext=false。
      也就是说这条显式声明只是把"隐式依赖平台默认"变成"写在纸面上"，
      但它有实际价值：任何人后续新增 <domain-config> 时，
      不会误以为"没写 clear=false 就是允许"。
    -->
    <base-config cleartextTrafficPermitted="false" />

    <!--
      开发用 host（模拟器访问宿主机 / 本机回环）。

      注意这三条只在 debug 语义下有意义，但 Android 的
      network-security-config 不支持按 buildType 分文件的热切换
      （要靠 src/debug/res 覆盖）。这里的取舍是：
      留着它们，攻击面为零 —— 10.0.2.2 是模拟器专用地址，
      127.0.0.1/localhost 指向本机，外部无法借此发起请求。
      删掉它们的代价是本地联调全裸奔，收益是几条无害的白名单条目。
      所以保留，但明确标注用途，避免被当成生产配置继承下去。
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>

    <!-- 校内系统 http 明文（这些服务器确实只有 http，无法改成 https） -->
    <domain-config cleartextTrafficPermitted="true">
        <!--
          教务系统（正方 V9）的 5 条 IP 直连线路 + 域名线路。
          必须与 JwApi.kt 的 `hosts` 列表保持一致：
          login() 会依次尝试这 6 条，任何一条没在这里放行，
          都会在系统层被 CleartextNotPermittedException 拒掉，
          然后被 login() 的 `catch (e: Exception)` 当成"线路不可达"，
          最终报成"所有教务线路均无法连接，请检查网络" —— 错误信息会误导排查方向。
          改这里时请同步改 JwApi.kt:220-228。
        -->
        <domain includeSubdomains="true">210.43.24.137</domain>
        <domain includeSubdomains="true">210.43.24.138</domain>
        <domain includeSubdomains="true">210.43.24.139</domain>
        <domain includeSubdomains="true">210.43.24.140</domain>
        <domain includeSubdomains="true">210.43.24.144</domain>
        <domain includeSubdomains="true">xynu.edu.cn</domain>
        <domain includeSubdomains="true">222.21.62.201</domain>
        <domain includeSubdomains="true">libopac.xynu.edu.cn</domain>
        <domain includeSubdomains="true">libspace.xynu.edu.cn</domain>
        <domain includeSubdomains="true">mobilelib.wx.chaoxing.com</domain>
        <domain includeSubdomains="true">17wanxiao.com</domain>
        <domain includeSubdomains="true">hzsun.com</domain>
    </domain-config>
</network-security-config>
