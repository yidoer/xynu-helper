<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 后端代理（本地开发：模拟器通过 10.0.2.2 访问宿主机；部署后改为你的后端域名/IP） -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
    <!-- 校内系统 http 明文 -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">210.43.24.144</domain>
        <domain includeSubdomains="true">xynu.edu.cn</domain>
        <domain includeSubdomains="true">222.21.62.201</domain>
        <domain includeSubdomains="true">libopac.xynu.edu.cn</domain>
        <domain includeSubdomains="true">libspace.xynu.edu.cn</domain>
        <domain includeSubdomains="true">mobilelib.wx.chaoxing.com</domain>
        <domain includeSubdomains="true">17wanxiao.com</domain>
        <domain includeSubdomains="true">hzsun.com</domain>
    </domain-config>
</network-security-config>